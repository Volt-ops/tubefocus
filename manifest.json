{
  "manifest_version": 3,
  "name": "TubeFocus – YouTube Distraction Remover",
  "short_name": "TubeFocus",
  "version": "1.0.0",
  "description": "Hide YouTube's home feed, Shorts, recommendations, comments and end screens. Keep search and the videos you chose to watch.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "TubeFocus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tubefocus@users.noreply.github.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
